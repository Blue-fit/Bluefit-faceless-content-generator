# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
# Loaded by pydantic-settings (app/config.py). Run commands from backend/.

# --- Google Gemini (Developer API) ---
# Standard AI Studio keys start with "AIza". Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false

# --- Cloudflare R2 (S3-compatible, EU jurisdiction bucket) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# --- Resend (email) ---
RESEND_API_KEY=
EMAIL_FROM=welkom@blue-fit.nl
CLIENT_EMAIL=
OPERATOR_EMAIL=

# --- Frontend (used as the link in the weekly digest email) ---
FRONTEND_URL=https://bluefit-faceless-content-generator.vercel.app

# --- Postgres (asyncpg DSN) ---
DATABASE_URL=postgresql://user:password@localhost:5432/content_agent

# --- App auth (bearer token returned to the client after login) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_BEARER_TOKEN=

# --- Login (simple username/password gate for the UI) ---
AUTH_USERNAME=
AUTH_PASSWORD=
