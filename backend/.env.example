# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
# Loaded by pydantic-settings (app/config.py). Run commands from backend/.

# --- Google Gemini (Developer API) ---
# Standard AI Studio keys start with "AIza". Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false

# --- Cloudflare R2 (S3-compatible, EU jurisdiction bucket) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# --- Resend (email) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
CLIENT_EMAIL=
OPERATOR_EMAIL=

# --- Postgres (self-hosted, asyncpg DSN) ---
DATABASE_URL=postgresql://user:password@localhost:5432/content_agent

# --- App auth (single long-lived bearer token in the client URL) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_BEARER_TOKEN=
